# Runner image for Terrapod K8s Jobs.
#
# Pure Python orchestrator — the bash entrypoint and the curl/jq/tar/unzip
# tooling it relied on are gone in v0.32.1. Only what the Python
# orchestrator (terrapod.runner.job_entrypoint) and its phase modules
# actually need is installed:
#
#   - python:3.13-slim base
#   - git + openssh-client + ca-certificates — for module sources
#     resolved by `tofu init` (terraform's `git::ssh://...` /
#     `git::https://...` schemes shell out to system git)
#   - opa — for the runner-side OPA policy evaluation (#343)
#
# Other tools the bash era pulled in (curl, jq, tar, unzip, openssl) are
# no longer installed. The Python phase modules use httpx for HTTP,
# json for parsing, tarfile/zipfile for extraction, and the stdlib's
# TLS stack.

# ── Builder ────────────────────────────────────────────────────────────
FROM python:3.13-slim AS builder

WORKDIR /build
COPY services/pyproject-runner.toml pyproject.toml
RUN pip install --no-cache-dir .

# ── Runtime ────────────────────────────────────────────────────────────
FROM python:3.13-slim
LABEL org.opencontainers.image.source=https://github.com/mattrobinsonsre/terrapod

# Bump APT_REFRESH to bust the cached apt layer and re-pull Debian
# security patches. See Dockerfile.api for the same pattern.
ARG APT_REFRESH=2026-06-06
RUN echo "apt-refresh=${APT_REFRESH}" \
    && apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
        git \
        openssh-client \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# OPA (Open Policy Agent) — the policy-as-code evaluation engine (#343).
# Statically-linked binary; we download it via the builder stage's
# Python toolchain rather than apt because OPA isn't packaged for
# Debian. Pinned, SHA256-verified. The Python-side download keeps the
# runtime image free of curl. TARGETARCH is set by buildx.
ARG TARGETARCH
ARG OPA_VERSION=1.17.0
COPY --from=builder /usr/local/bin/python /tmp/python
RUN ARCH="${TARGETARCH:-$(dpkg --print-architecture)}" \
    && /tmp/python -c "import urllib.request, hashlib, sys; \
        base=f'https://github.com/open-policy-agent/opa/releases/download/v${OPA_VERSION}'; \
        url=f'{base}/opa_linux_${ARCH}_static'; \
        sha_url=f'{url}.sha256'; \
        urllib.request.urlretrieve(url, '/usr/local/bin/opa'); \
        expected=urllib.request.urlopen(sha_url).read().decode().split()[0]; \
        h=hashlib.sha256(open('/usr/local/bin/opa','rb').read()).hexdigest(); \
        assert h == expected, f'sha256 mismatch: {h} vs {expected}'" \
    && rm /tmp/python \
    && chmod 0755 /usr/local/bin/opa \
    && /usr/local/bin/opa version

# Python deps from builder
COPY --from=builder /usr/local/lib/python3.13/site-packages /usr/local/lib/python3.13/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Runner Python module — only what the Job entrypoint imports.
WORKDIR /app
COPY services/terrapod/runner/__init__.py ./terrapod/runner/__init__.py
COPY services/terrapod/runner/runner_config.py ./terrapod/runner/runner_config.py
COPY services/terrapod/runner/download.py ./terrapod/runner/download.py
COPY services/terrapod/runner/exec_subprocess.py ./terrapod/runner/exec_subprocess.py
COPY services/terrapod/runner/lock_extender.py ./terrapod/runner/lock_extender.py
COPY services/terrapod/runner/job_entrypoint.py ./terrapod/runner/job_entrypoint.py
COPY services/terrapod/runner/phases/ ./terrapod/runner/phases/

# /home/runner is the writable HOME for UID 1000 — without it, tools
# that consult $HOME (helm's repository/index cache, kubectl's
# ~/.kube/cache, git's ~/.gitconfig, AWS CLI's ~/.aws) fall back to
# os.UserHomeDir() lookups that resolve to "/" for a UID with no
# /etc/passwd entry, then write to /.cache/… which isn't writable
# and triggers misleading "cannot be reached" errors from helm
# specifically. Keeping HOME off /workspace so terraform's .terraform/
# and the user's HCL stay separate from tool caches.
RUN mkdir -p /workspace /tmp/bin /home/runner \
    && chown -R 1000:1000 /workspace /tmp/bin /home/runner

USER 1000:1000
ENV HOME=/home/runner \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app
WORKDIR /workspace

ENTRYPOINT ["python", "-m", "terrapod.runner.job_entrypoint"]
