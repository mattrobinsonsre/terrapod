# Terrapod API test runner
# Includes all dev dependencies (pytest, ruff, mypy)
#
# The LEAF half. Everything expensive lives in `Dockerfile.test-base`, which is
# published and pulled rather than rebuilt per job (#2248) -- see that file for
# why and for the rule about what may not go in it. What is left here is COPY
# layers of this commit's own code and tests, measured at 0.0-0.1s each, so a
# build on a pulled base is seconds rather than a minute.
#
# `TEST_BASE_IMAGE` has no default on purpose. A default would let a stale or
# wrong base be used silently when the caller forgot to resolve one, and the
# whole point of the tag is that it describes the base's contents; `lib.sh` is
# the one place that computes it.
ARG TEST_BASE_IMAGE
FROM ${TEST_BASE_IMAGE}

WORKDIR /app

# Copy application and test code
COPY services/terrapod ./terrapod
COPY services/tests ./tests
# Alembic migrations — the migration-reversibility + expand/contract contract
# tests (tests/db) parse these; schema_version.py also resolves them at runtime.
COPY alembic ./alembic

# The image Dockerfiles themselves, so tests can assert what an image ships.
# `engines/` must be COPYed into the listener image or the listener crashes on
# import at startup — a failure no source-only test could see (#1487).
COPY docker ./docker

# The message catalogues, so a test can check that an engine's declared
# vocabulary namespace actually exists in them (#1521). Just the JSON — the
# component scan that needs web/src lives on the frontend side, where the
# other .tsx linting already is.
COPY web/messages ./web/messages
# ...and the one frontend module that has to agree with the engine
# registry, so the guard runs in CI rather than only on a laptop.
COPY web/src/lib/phase-vocabulary.ts ./web/src/lib/phase-vocabulary.ts

# The deprecation record, so a test can check the Sunset header the API emits
# names the same date the docs publish (#1529).
COPY docs/deprecations.md ./docs/deprecations.md

# The three minimal images' declared manifests and their locks, so the
# dependency-pin guards (tests/test_dependency_pins.py) can check that every
# requirement is `==` pinned AND hashed — which is what `--require-hashes`
# depends on — and that each manifest's CVE floors are actually satisfied by the
# version pinned for it. Without these the guards would be skipped rather than
# failing, so a stale lock would ship quietly (GHSA-rgvw-c74c-h75w).
#
# Deliberately AFTER the dependency-install layer above: putting them in that
# COPY would bust the install cache whenever a minimal manifest changed.
COPY services/pyproject-listener.toml services/pyproject-migrations.toml \
     services/pyproject-runner.toml ./
COPY services/requirements-listener.txt services/requirements-migrations.txt \
     services/requirements-runner.txt ./
# AI-analysis evaluation harness (#602) — committed eval suite. Imported by
# the offline corpus/rubric tests and run live (model sweep) on demand.
COPY services/ai_eval ./ai_eval
# Helm chart values — the Helm-value-removal contract test (tests/helm) parses
# values.yaml as text/YAML to freeze the operator-facing value keys. Chart only
# (values + templates); no helm binary is invoked in the Python image.
# The image Dockerfiles themselves, so a test can assert what an image SHIPS.
# `reserved_env.py` was imported by the runner Job and never COPYed into the
# runner image, so every Job died at import — a failure no source-only test could
# see, because the module is present in the tree the tests import from.
COPY docker ./docker

COPY helm ./helm

# Source for the API↔SDK↔provider contract test (tests/test_api_sdk_contract.py).
# The test reads these files as raw text — no Go build is performed in the
# Python image. Kept narrow (.go files only) so the image stays slim.
COPY go-terrapod/*.go ./go-terrapod/
COPY provider/internal/resources/workspace/*.go ./provider/internal/resources/workspace/
COPY provider/internal/datasources/workspace/*.go ./provider/internal/datasources/workspace/
# The MCP tool definitions, for the workspace-setting parity gate. Without this
# the gate's `_surface()` raises rather than skipping -- deliberately, because a
# gate that cannot read the file it checks proves nothing.
COPY mcp/internal/mcpserver/crud.go ./mcp/internal/mcpserver/crud.go

# The two admin pages the workspace-setting parity gate reads (#1763). The gate
# requires every bulk-settable setting to be reachable from the GUI too; without
# these files it cannot see the GUI and would pass vacuously, which is exactly
# the failure it exists to prevent -- `ai-policy-mode` shipped on three surfaces
# out of four because the rule was a convention nothing checked.
COPY web/src/app/admin/bulk-update/page.tsx ./web/src/app/admin/bulk-update/page.tsx
COPY web/src/app/admin/autodiscovery/page.tsx ./web/src/app/admin/autodiscovery/page.tsx
# Read by tests/api/test_workspace_setting_parity.py's create/edit parity gate
# (#2253), which requires every attribute the workspace create path accepts to
# be offered by the shared field table -- and requires the create form to
# actually READ that table, because the forms sharing no field code is how they
# diverged to 13 controls against ~50 accepted attributes in the first place.
# Without these two files the gate raises rather than passing vacuously; the
# `_surface()` helper says so in its own error.
COPY web/src/lib/workspace-fields.ts ./web/src/lib/workspace-fields.ts
# The whole route, deliberately, because COPY globs its source: `[id]` is a
# character class matching one of `i`/`d`, never the literal directory, and
# quoting does not help -- the parser strips quotes and still globs. A per-file
# COPY of the dynamic route silently copies nothing and the gate then raises.
COPY web/src/app/workspaces ./web/src/app/workspaces
# Read by tests/auth/test_cli_login_timing.py, which ties this page's
# POLL_TIMEOUT_MS to AUTH_CODE_TTL. Without the file the gate raises.
COPY web/src/app/auth/cli-complete/page.tsx ./web/src/app/auth/cli-complete/page.tsx

# Storage data directory for tests
RUN mkdir -p /var/lib/terrapod/storage

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Default: run pytest
CMD ["pytest", "-v", "--tb=short"]
